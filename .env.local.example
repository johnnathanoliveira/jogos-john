# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ─── Spotify API ──────────────────────────────────────────────────────────────
# Obtenha em: https://developer.spotify.com/dashboard → Settings do app
SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# URI de redirect OAuth — deve ser adicionada nas configurações do app Spotify:
#   Dashboard → seu app → Edit → Redirect URIs → Add URI
# Desenvolvimento:
SPOTIFY_REDIRECT_URI=https://jogos-john.vercel.app/api/spotify/callback
# Produção (Vercel) — descomente e preencha após o deploy:
# SPOTIFY_REDIRECT_URI=https://seu-app.vercel.app/api/spotify/callback

# ─── YouTube Data API v3 (opcional) ──────────────────────────────────────────
YOUTUBE_API_KEY=sua_youtube_api_key_aqui
